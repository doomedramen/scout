{
  "serverEnabled": true,
  "agentIds": [],
  "scheduleSeconds": 300,
  "entryPoints": [
    {
      "id": "ssh-default",
      "name": "SSH",
      "transport": "tcp",
      "port": 22,
      "accessMethod": "ssh",
      "enabled": true
    },
    {
      "id": "ssh-alt",
      "name": "SSH alternate",
      "transport": "tcp",
      "port": 2222,
      "accessMethod": "ssh",
      "enabled": false
    }
  ],
  "limits": {
    "probesPerSecond": 10,
    "concurrency": 16,
    "targetBudget": 256,
    "attemptBudget": 512,
    "timeoutMilliseconds": 2000,
    "runDeadlineSeconds": 600
  }
}
