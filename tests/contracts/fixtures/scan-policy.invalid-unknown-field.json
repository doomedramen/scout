{
  "serverEnabled": true,
  "agentIds": [],
  "scheduleSeconds": 300,
  "entryPoints": [
    {
      "id": "ssh-default",
      "name": "SSH",
      "transport": "tcp",
      "port": 22,
      "accessMethod": "ssh",
      "enabled": true
    }
  ],
  "limits": {
    "probesPerSecond": 10,
    "concurrency": 16,
    "targetBudget": 256,
    "attemptBudget": 256,
    "timeoutMilliseconds": 2000,
    "runDeadlineSeconds": 600,
    "arbitraryCommand": "nmap --script vuln"
  },
  "shellCommand": "uname -a"
}
