#!/bin/sh
set -eu

SCOUT_DIR=${SCOUT_DIR:-/opt/scout}
COMPOSE_FILE=$SCOUT_DIR/compose.yaml
COMPOSE_URL=${SCOUT_COMPOSE_URL:-https://raw.githubusercontent.com/doomedramen/scout/main/compose.yaml}

die() {
  printf 'scout: %s\n' "$1" >&2
  exit 1
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is required."
  docker compose version >/dev/null 2>&1 || die "Docker Compose is required."
}

download_compose() {
  temporary=$COMPOSE_FILE.tmp.$$
  curl -fsSL "$COMPOSE_URL" -o "$temporary" || {
    rm -f "$temporary"
    die "Could not download the current Compose definition."
  }
  docker compose -f "$temporary" config >/dev/null 2>&1 || {
    rm -f "$temporary"
    die "The downloaded Compose definition failed validation."
  }
  mv "$temporary" "$COMPOSE_FILE"
}

ensure_compose() {
  mkdir -p "$SCOUT_DIR"
  if [ ! -s "$COMPOSE_FILE" ]; then
    download_compose
  fi
}

compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

read_passphrase() {
  if [ -n "${SCOUT_BACKUP_PASSPHRASE:-}" ]; then
    printf '%s' "$SCOUT_BACKUP_PASSPHRASE"
    return
  fi
  printf 'Backup passphrase: ' >&2
  stty -echo
  IFS= read -r passphrase
  stty echo
  printf '\n' >&2
  [ -n "$passphrase" ] || die "A backup passphrase is required."
  printf '%s' "$passphrase"
}

run_ops() {
  operation=$1
  archive=$2
  passphrase=$3
  archive_directory=$(CDPATH="" cd -- "$(dirname "$archive")" && pwd)
  archive_name=$(basename "$archive")
  printf '%s\n' "$passphrase" | compose run --rm --no-deps -v "$archive_directory:/backup" \
    --entrypoint node scout /usr/local/bin/scout-ops.mjs "$operation" "/backup/$archive_name"
}

run_data_op() {
  operation=$1
  if [ "$operation" = snapshot ] || [ "$operation" = restore-snapshot ]; then
    target=$2
    [ -n "$target" ] || die "An update snapshot directory is required."
    [ "$operation" = snapshot ] && mkdir -p "$target"
    compose run --rm --no-deps --user 0 -v "$target:/update" --entrypoint node scout \
      /usr/local/bin/scout-ops.mjs "$operation" /update
  else
    compose run --rm --no-deps --user 0 --entrypoint node scout /usr/local/bin/scout-ops.mjs "$@"
  fi
}

compose_image() {
  compose config --images | tail -n 1
}

write_rollback_override() {
  rollback_override=$SCOUT_DIR/.scout-rollback-compose.$$
  printf 'services:\n  scout:\n    image: %s\n' "$rollback_tag" >"$rollback_override"
}

rollback_update() {
  if [ -f "$previous" ]; then mv -f "$previous" "$COMPOSE_FILE"; fi
  compose stop scout >/dev/null 2>&1 || true
  run_data_op restore-snapshot "$update_snapshot" >/dev/null 2>&1 || true
  if [ -n "${rollback_tag:-}" ]; then
    write_rollback_override
    docker compose -f "$COMPOSE_FILE" -f "$rollback_override" up -d --wait >/dev/null 2>&1 || true
    rm -f "$rollback_override"
  else
    compose up -d --wait >/dev/null 2>&1 || true
  fi
  run_data_op set-authority "$previous_authority" >/dev/null 2>&1 || true
  rm -rf "$update_snapshot"
  rm -f "$previous"
  if [ -n "${rollback_tag:-}" ]; then docker image rm "$rollback_tag" >/dev/null 2>&1 || true; fi
  die "Update failed; the previous Compose definition, image, and database were restored."
}

require_docker
command=${1:-status}

case "$command" in
  up)
    ensure_compose
    compose up -d --wait
    ;;
  update)
    ensure_compose
    update_snapshot=$SCOUT_DIR/.scout-update-snapshot.$$
    previous=$COMPOSE_FILE.previous.$$
    image_ref=$(compose_image)
    old_image_id=$(docker image inspect --format '{{.Id}}' "$image_ref" 2>/dev/null || true)
    rollback_tag="scout:rollback-$$"
    if [ -n "$old_image_id" ]; then docker tag "$old_image_id" "$rollback_tag"; else rollback_tag=''; fi
    previous_authority=$(run_data_op authority 2>/dev/null || printf 'false')
    run_data_op snapshot "$update_snapshot" >/dev/null || rollback_update
    run_data_op pause >/dev/null || rollback_update
    cp "$COMPOSE_FILE" "$previous"
    download_compose
    image_ref=$(compose_image)
    compose pull scout || rollback_update
    new_image_id=$(docker image inspect --format '{{.Id}}' "$image_ref" 2>/dev/null || true)
    [ -n "$new_image_id" ] || rollback_update
    image_digest=$(docker image inspect --format '{{join .RepoDigests "\n"}}' "$image_ref" 2>/dev/null | tail -n 1 || true)
    if [ -z "$image_digest" ] && [ "${SCOUT_ALLOW_UNDIGESTED_IMAGE:-false}" != "true" ]; then
      rollback_update
    fi
    compose up -d --wait || rollback_update
    run_data_op set-authority "$previous_authority" >/dev/null || rollback_update
    rm -f "$previous"
    rm -rf "$update_snapshot"
    if [ -n "${rollback_tag:-}" ]; then docker image rm "$rollback_tag" >/dev/null 2>&1 || true; fi
    ;;
  backup)
    ensure_compose
    archive=${2:-scout-backup-$(date -u +%Y%m%dT%H%M%SZ).scoutbak}
    passphrase=$(read_passphrase)
    compose stop scout
    if ! run_ops backup "$archive" "$passphrase"; then
      compose start scout || true
      die "Backup failed."
    fi
    compose up -d --wait
    printf 'scout: backup written to %s\n' "$PWD/$archive"
    ;;
  restore)
    ensure_compose
    archive=${2:-}
    [ -n "$archive" ] || die "Usage: scout restore BACKUP.scoutbak"
    [ -f "$archive" ] || die "Backup archive not found: $archive"
    passphrase=$(read_passphrase)
    compose stop scout
    if ! run_ops restore "$(basename "$archive")" "$passphrase"; then
      compose start scout || true
      die "Restore failed; the existing data was left in place."
    fi
    compose up -d --wait
    printf 'scout: restore validated; review the instance before enabling work\n'
    ;;
  status)
    ensure_compose
    compose ps
    ;;
  logs)
    ensure_compose
    shift
    compose logs "$@"
    ;;
  setup-token)
    ensure_compose
    compose logs --no-color scout | grep 'Scout owner setup token' || die "No unused setup token is visible in the logs."
    ;;
  trust-pin)
    ensure_compose
    public_url=${SCOUT_PUBLIC_URL:-}
    if [ -z "$public_url" ] && [ -f "$SCOUT_DIR/.env" ]; then
      public_url=$(sed -n 's/^SCOUT_PUBLIC_URL=//p' "$SCOUT_DIR/.env" | tail -n 1)
      public_url=${public_url#\"}
      public_url=${public_url%\"}
      public_url=${public_url#\'}
      public_url=${public_url%\'}
    fi
    public_url=${public_url%/}
    if [ -z "$public_url" ]; then
      port=${SCOUT_PORT:-8080}
      if [ -f "$SCOUT_DIR/.env" ]; then
        configured_port=$(sed -n 's/^SCOUT_PORT=//p' "$SCOUT_DIR/.env" | tail -n 1)
        [ -n "$configured_port" ] && port=$configured_port
      fi
      public_url="http://127.0.0.1:$port"
    fi
    curl -fsSL "$public_url/api/v1/bootstrap/fingerprint" || die "No bootstrap fingerprint is available."
    ;;
  *)
    die "Usage: scout {up|update|backup|restore|status|logs|setup-token|trust-pin}"
    ;;
esac
