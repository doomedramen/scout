[Unit]
Description=Scout Linux monitoring agent
Documentation=https://github.com/doomedramen/scout
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=scout-agent
Group=scout-agent
EnvironmentFile=-/etc/scout/agent.env
Environment="SCOUT_SERVER_URL=__SCOUT_SERVER_URL__"
Environment="SCOUT_AGENT_DATA_DIR=/var/lib/scout/agent"
ExecStart=/usr/local/libexec/scout-agent --daemon --invitation-file /var/lib/scout/agent/invitation --data-dir /var/lib/scout/agent
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scout/agent
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
