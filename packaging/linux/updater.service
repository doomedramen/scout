[Unit]
Description=Scout constrained agent updater
After=scout-agent.service

[Service]
Type=oneshot
User=scout-agent
Group=scout-agent
ExecStart=/usr/local/bin/scout-updater --root /var/lib/scout/updater --recover
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scout/updater
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
