{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/scan-result-page.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "runId",
    "leaseEpoch",
    "scopeRevision",
    "pageOrdinal",
    "observedFrom",
    "observedTo",
    "final",
    "results"
  ],
  "properties": {
    "protocolVersion": { "type": "integer", "const": 1 },
    "runId": { "$ref": "scan-common.json#/$defs/uuid" },
    "leaseEpoch": { "type": "integer", "minimum": 1 },
    "scopeRevision": { "$ref": "scan-common.json#/$defs/revision" },
    "pageOrdinal": { "type": "integer", "minimum": 0, "maximum": 16383 },
    "observedFrom": { "$ref": "scan-common.json#/$defs/timestamp" },
    "observedTo": { "$ref": "scan-common.json#/$defs/timestamp" },
    "final": { "type": "boolean" },
    "results": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["address", "entryPointId", "transport", "port", "outcome", "observedAt"],
        "properties": {
          "address": { "type": "string", "minLength": 2, "maxLength": 45 },
          "entryPointId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "transport": { "$ref": "scan-common.json#/$defs/transport" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "outcome": { "$ref": "scan-common.json#/$defs/outcome" },
          "reasonCode": { "$ref": "scan-common.json#/$defs/reasonCode" },
          "latencyMilliseconds": { "type": ["number", "null"], "minimum": 0, "maximum": 10000 },
          "observedAt": { "$ref": "scan-common.json#/$defs/timestamp" }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": ["object", "null"],
      "required": ["targetsPlanned", "attemptsPlanned", "attemptsCompleted", "partialReason"],
      "properties": {
        "targetsPlanned": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "attemptsPlanned": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "attemptsCompleted": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "partialReason": { "$ref": "scan-common.json#/$defs/partialReason" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "final": { "const": true } }, "required": ["final"] },
      "then": { "required": ["summary"], "properties": { "summary": { "type": "object" } } },
      "else": { "properties": { "summary": { "type": "null" } } }
    }
  ],
  "additionalProperties": false,
  "$comment": "The decoded HTTP body is capped at 1 MiB. Identity is taken from authenticated transport, never this body."
}
