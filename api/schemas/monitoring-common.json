{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/monitoring-common.json",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "targetKind": { "type": "string", "enum": ["fleet", "site", "device"] },
    "severity": { "type": "string", "enum": ["warning", "critical"] },
    "ruleKind": { "type": "string", "enum": ["numeric", "state"] },
    "stateName": {
      "type": "string",
      "enum": ["host_offline", "service_failed", "service_required_inactive", "collector_degraded", "hardware_fault"]
    },
    "metricName": {
      "type": "string",
      "enum": [
        "cpu.utilization",
        "cpu.user_percent",
        "cpu.system_percent",
        "cpu.iowait_percent",
        "cpu.steal_percent",
        "load.1m",
        "load.5m",
        "load.15m",
        "memory.used",
        "memory.capacity",
        "memory.used_percent",
        "filesystem.used",
        "filesystem.capacity",
        "filesystem.used_percent",
        "host.uptime",
        "network.receive_rate",
        "network.transmit_rate",
        "swap.used",
        "swap.capacity",
        "disk.read_rate",
        "disk.write_rate",
        "disk.utilization",
        "disk.read_latency",
        "disk.write_latency",
        "smart.temperature",
        "smart.wear_percent",
        "smart.error_count",
        "zfs.pool.used",
        "zfs.pool.capacity",
        "zfs.dataset.used",
        "zfs.dataset.available",
        "zfs.pool.read_rate",
        "zfs.pool.write_rate",
        "sensor.temperature",
        "sensor.fan_speed",
        "gpu.utilization",
        "gpu.memory.used",
        "gpu.memory.capacity",
        "gpu.temperature",
        "gpu.power"
      ]
    },
    "numericCondition": {
      "type": "object",
      "required": ["metric", "operator", "triggerValue", "clearValue", "triggerSeconds", "clearSeconds"],
      "properties": {
        "metric": { "$ref": "#/$defs/metricName" },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operator": { "type": "string", "enum": ["gt", "lt"] },
        "triggerValue": { "type": "number" },
        "clearValue": { "type": "number" },
        "triggerSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "clearSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
      },
      "additionalProperties": false,
      "$comment": "gt requires clearValue < triggerValue; lt requires clearValue > triggerValue."
    },
    "stateCondition": {
      "type": "object",
      "required": ["state", "triggerSeconds", "clearSeconds"],
      "properties": {
        "state": { "$ref": "#/$defs/stateName" },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "servicePattern": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.@?*:-]+$" },
        "collectorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "triggerSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "clearSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "minimumConsecutiveSamples": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "alertCondition": {
      "oneOf": [{ "$ref": "#/$defs/numericCondition" }, { "$ref": "#/$defs/stateCondition" }]
    },
    "availability": {
      "type": "string",
      "enum": ["current", "stale", "missing", "unsupported", "unavailable"]
    },
    "targetId": { "type": "string", "format": "uuid" },
    "safeText": { "type": "string", "maxLength": 512 }
  },
  "additionalProperties": false
}
