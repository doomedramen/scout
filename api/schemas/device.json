{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "displayName", "availability", "metricFreshness", "collectorStates"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "displayName": { "type": "string" },
    "siteId": { "type": "string", "format": "uuid" },
    "platform": { "type": "string" },
    "architecture": { "type": "string" },
    "hostname": { "type": "string" },
    "addresses": { "type": "array", "items": { "type": "string" } },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "namespace", "value", "source", "confidence", "firstSeen", "lastSeen"],
        "properties": {
          "kind": { "type": "string" },
          "namespace": { "type": "string" },
          "value": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "type": "number" },
          "firstSeen": { "type": "string", "format": "date-time" },
          "lastSeen": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "agentId": { "type": "string" },
    "availability": { "enum": ["connecting", "online", "offline", "revoked"] },
    "metricFreshness": { "type": "object" },
    "lastSeen": { "type": ["string", "null"], "format": "date-time" },
    "agentVersion": { "type": ["string", "null"] },
    "collectorStates": { "type": "array" },
    "currentMetrics": { "type": "object" }
  },
  "additionalProperties": false
}
