{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "displayName", "availability", "metricFreshness", "collectorStates"],
  "properties": {
    "id": { "type": "string", "format": "uuid" }, "displayName": { "type": "string" }, "siteId": { "type": "string", "format": "uuid" }, "platform": { "type": "string" }, "addresses": { "type": "array", "items": { "type": "string" } }, "availability": { "enum": ["connecting", "online", "offline", "revoked"] }, "metricFreshness": { "type": "object" }, "lastSeen": { "type": ["string", "null"], "format": "date-time" }, "agentVersion": { "type": ["string", "null"] }, "collectorStates": { "type": "array" }, "currentMetrics": { "type": "object" }
  },
  "additionalProperties": false
}
