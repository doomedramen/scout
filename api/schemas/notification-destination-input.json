{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/notification-destination-input.json",
  "type": "object",
  "required": ["name", "baseUrl", "topic"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "baseUrl": { "type": "string", "format": "uri", "minLength": 1, "maxLength": 2048 },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "writeOnly": true
    },
    "token": {
      "type": ["string", "null"],
      "maxLength": 4096,
      "writeOnly": true
    },
    "enabled": { "type": "boolean", "default": false }
  },
  "additionalProperties": false,
  "$comment": "The server rejects query strings, fragments, credentials, redirects, public HTTP, and reserved ntfy routing names."
}
