{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/incident.json",
  "type": "object",
  "required": [
    "id",
    "lineageId",
    "entityId",
    "deviceId",
    "status",
    "severity",
    "openedAt",
    "observedAt",
    "evidenceState",
    "notificationSuppression",
    "revision"
  ],
  "properties": {
    "id": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "lineageId": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "deviceId": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "siteId": { "type": ["string", "null"], "format": "uuid" },
    "status": { "type": "string", "enum": ["active", "resolved", "closed"] },
    "severity": { "$ref": "monitoring-common.json#/$defs/severity" },
    "ruleSnapshot": {
      "type": "object",
      "required": ["name", "kind", "condition"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "$ref": "monitoring-common.json#/$defs/ruleKind" },
        "condition": { "$ref": "monitoring-common.json#/$defs/alertCondition" }
      },
      "additionalProperties": false
    },
    "openedAt": { "$ref": "monitoring-common.json#/$defs/timestamp" },
    "observedAt": { "$ref": "monitoring-common.json#/$defs/timestamp" },
    "acknowledgedAt": { "type": ["string", "null"], "format": "date-time" },
    "acknowledgedBy": { "type": ["string", "null"], "maxLength": 128 },
    "closedAt": { "type": ["string", "null"], "format": "date-time" },
    "closeReason": {
      "type": ["string", "null"],
      "enum": ["recovered", "rule_changed", "disabled", "retired", "decommissioned", "administrative"]
    },
    "evidenceState": { "type": "string", "enum": ["fresh", "unknown", "unsupported"] },
    "evidence": {
      "type": ["object", "null"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"], "maxLength": 64 },
        "threshold": { "type": ["number", "null"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rawState": { "type": ["string", "null"], "maxLength": 128 },
        "observedAt": { "$ref": "monitoring-common.json#/$defs/timestamp" }
      },
      "additionalProperties": false,
      "maxProperties": 6
    },
    "notificationSuppression": {
      "type": "object",
      "required": ["suppressed", "reasons"],
      "properties": {
        "suppressed": { "type": "boolean" },
        "reasons": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 64 } }
      },
      "additionalProperties": false
    },
    "revision": { "$ref": "monitoring-common.json#/$defs/revision" }
  },
  "additionalProperties": false
}
