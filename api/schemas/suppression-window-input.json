{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/suppression-window-input.json",
  "type": "object",
  "required": ["name", "targetKind", "enabled", "mode"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "targetKind": { "$ref": "monitoring-common.json#/$defs/targetKind" },
    "targetId": { "$ref": "monitoring-common.json#/$defs/targetId" },
    "enabled": { "type": "boolean" },
    "mode": { "type": "string", "enum": ["recurring", "oneTime"] },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 128 },
    "weekdays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 }
    },
    "startLocal": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "endLocal": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "startsAt": { "type": "string", "format": "date-time" },
    "endsAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "targetKind": { "const": "fleet" } }, "required": ["targetKind"] },
      "then": { "not": { "required": ["targetId"] } },
      "else": { "required": ["targetId"] }
    },
    {
      "if": { "properties": { "mode": { "const": "recurring" } }, "required": ["mode"] },
      "then": {
        "required": ["timezone", "weekdays", "startLocal", "endLocal"],
        "not": { "anyOf": [{ "required": ["startsAt"] }, { "required": ["endsAt"] }] }
      },
      "else": {
        "required": ["startsAt", "endsAt"],
        "not": {
          "anyOf": [
            { "required": ["timezone"] },
            { "required": ["weekdays"] },
            { "required": ["startLocal"] },
            { "required": ["endLocal"] }
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$comment": "Recurring times use IANA zones and ISO weekdays. One-time windows are UTC, end-exclusive, and max 365 days."
}
