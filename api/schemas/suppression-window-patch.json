{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/suppression-window-patch.json",
  "type": "object",
  "required": ["expectedRevision"],
  "properties": {
    "expectedRevision": { "$ref": "monitoring-common.json#/$defs/revision" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "targetKind": { "$ref": "monitoring-common.json#/$defs/targetKind" },
    "targetId": { "$ref": "monitoring-common.json#/$defs/targetId" },
    "enabled": { "type": "boolean" },
    "mode": { "type": "string", "enum": ["recurring", "oneTime"] },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 128 },
    "weekdays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 }
    },
    "startLocal": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "endLocal": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "startsAt": { "type": "string", "format": "date-time" },
    "endsAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$comment": "If mode is supplied, the same mutually exclusive recurring/oneTime shape as suppression-window-input applies."
}
