{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["kind", "secret", "allowedUse", "targets"],
  "properties": {
    "kind": { "type": "string", "maxLength": 64 },
    "authMethod": { "type": "string", "enum": ["password", "private_key"] },
    "secret": { "type": "string", "writeOnly": true, "maxLength": 8192 },
    "allowedUse": { "type": "array", "items": { "type": "string" } },
    "targets": { "type": "array", "items": { "type": "string" } },
    "endpoint": { "type": "string", "maxLength": 256 },
    "username": { "type": "string", "maxLength": 128 }
  },
  "additionalProperties": false
}
