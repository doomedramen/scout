{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/alert-rule-patch.json",
  "type": "object",
  "required": ["expectedRevision"],
  "properties": {
    "expectedRevision": { "$ref": "monitoring-common.json#/$defs/revision" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "severity": { "$ref": "monitoring-common.json#/$defs/severity" },
    "enabled": { "type": "boolean" },
    "condition": { "$ref": "monitoring-common.json#/$defs/alertCondition" }
  },
  "additionalProperties": false,
  "$comment": "Lineage identity fields targetKind, targetId, and kind are immutable."
}
