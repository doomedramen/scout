{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/monitoring-settings-patch.json",
  "type": "object",
  "required": ["expectedRevision"],
  "properties": {
    "expectedRevision": { "$ref": "monitoring-common.json#/$defs/revision" },
    "retention": {
      "type": "object",
      "properties": {
        "rawDays": { "type": "integer", "minimum": 1, "maximum": 30 },
        "fiveMinuteDays": { "type": "integer", "minimum": 1, "maximum": 90 },
        "hourlyDays": { "type": "integer", "minimum": 1, "maximum": 365 }
      },
      "additionalProperties": false
    },
    "diskBudgetBytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
    "retentionPreviewId": { "$ref": "monitoring-common.json#/$defs/uuid" }
  },
  "additionalProperties": false,
  "$comment": "A retention reduction requires a matching unexpired preview bound to expectedRevision."
}
