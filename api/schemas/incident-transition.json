{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/incident-transition.json",
  "type": "object",
  "required": ["id", "incidentId", "sequence", "kind", "occurredAt", "effectiveRevision"],
  "properties": {
    "id": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "incidentId": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "kind": {
      "type": "string",
      "enum": ["triggered", "acknowledged", "unknown", "fresh", "recovered", "administrative_close"]
    },
    "occurredAt": { "$ref": "monitoring-common.json#/$defs/timestamp" },
    "actor": { "type": ["string", "null"], "maxLength": 128 },
    "evidence": { "$ref": "incident.json#/properties/evidence" },
    "effectiveRevision": { "$ref": "monitoring-common.json#/$defs/revision" }
  },
  "additionalProperties": false
}
