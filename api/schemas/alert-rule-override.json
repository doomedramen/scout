{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/alert-rule-override.json",
  "type": "object",
  "required": ["id", "lineageId", "targetKind", "targetId", "severity", "enabled", "condition", "revision"],
  "properties": {
    "id": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "lineageId": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "targetKind": { "type": "string", "enum": ["site", "device"] },
    "targetId": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "severity": { "$ref": "monitoring-common.json#/$defs/severity" },
    "enabled": { "type": "boolean" },
    "condition": { "$ref": "monitoring-common.json#/$defs/alertCondition" },
    "revision": { "$ref": "monitoring-common.json#/$defs/revision" },
    "createdAt": { "$ref": "monitoring-common.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "monitoring-common.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
