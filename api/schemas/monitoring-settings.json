{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/monitoring-settings.json",
  "type": "object",
  "required": ["revision", "defaultsVersion", "notificationsPaused", "retention", "diskBudgetBytes"],
  "properties": {
    "revision": { "$ref": "monitoring-common.json#/$defs/revision" },
    "defaultsVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "notificationsPaused": { "type": "boolean" },
    "retention": {
      "type": "object",
      "required": ["rawDays", "fiveMinuteDays", "hourlyDays"],
      "properties": {
        "rawDays": { "type": "integer", "minimum": 1, "maximum": 30 },
        "fiveMinuteDays": { "type": "integer", "minimum": 1, "maximum": 90 },
        "hourlyDays": { "type": "integer", "minimum": 1, "maximum": 365 }
      },
      "additionalProperties": false
    },
    "diskBudgetBytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
