{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/suppression-window.json",
  "type": "object",
  "required": ["id", "name", "targetKind", "enabled", "mode", "revision"],
  "properties": {
    "id": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "targetKind": { "$ref": "monitoring-common.json#/$defs/targetKind" },
    "targetId": { "type": ["string", "null"], "format": "uuid" },
    "enabled": { "type": "boolean" },
    "mode": { "type": "string", "enum": ["recurring", "oneTime"] },
    "timezone": { "type": ["string", "null"], "maxLength": 128 },
    "weekdays": {
      "type": "array",
      "maxItems": 7,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 }
    },
    "startLocal": { "type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "endLocal": { "type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "startsAt": { "type": ["string", "null"], "format": "date-time" },
    "endsAt": { "type": ["string", "null"], "format": "date-time" },
    "revision": { "$ref": "monitoring-common.json#/$defs/revision" },
    "createdAt": { "$ref": "monitoring-common.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "monitoring-common.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
