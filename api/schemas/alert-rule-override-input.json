{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/alert-rule-override-input.json",
  "type": "object",
  "required": ["targetKind", "targetId", "severity", "enabled", "condition"],
  "properties": {
    "targetKind": { "type": "string", "enum": ["site", "device"] },
    "targetId": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "severity": { "$ref": "monitoring-common.json#/$defs/severity" },
    "enabled": { "type": "boolean" },
    "condition": { "$ref": "monitoring-common.json#/$defs/alertCondition" }
  },
  "additionalProperties": false
}
