{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/candidate-detail.json",
  "type": "object",
  "required": ["candidate", "entryPoints", "accessRequests", "enrollment"],
  "properties": {
    "candidate": { "$ref": "candidate.json" },
    "entryPoints": { "$ref": "entry-point-observation-list.json" },
    "accessRequests": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "method", "endpoint", "reasonCode", "state", "updatedAt"],
        "properties": {
          "id": { "$ref": "scan-common.json#/$defs/uuid" },
          "method": { "type": "string", "enum": ["ssh"] },
          "endpoint": { "type": "string", "minLength": 2, "maxLength": 256 },
          "reasonCode": {
            "type": "string",
            "enum": [
              "missing_credentials",
              "invalid_credentials",
              "insufficient_privilege",
              "host_trust_required",
              "server_connectivity_required",
              "unsupported_platform"
            ]
          },
          "state": { "type": "string", "enum": ["open", "reevaluating", "resolved", "superseded", "closed"] },
          "safeDetails": {
            "type": "object",
            "maxProperties": 16,
            "additionalProperties": { "type": "string", "maxLength": 256 }
          },
          "updatedAt": { "$ref": "scan-common.json#/$defs/timestamp" }
        },
        "additionalProperties": false
      }
    },
    "enrollment": {
      "type": ["object", "null"],
      "required": ["jobId", "state"],
      "properties": {
        "jobId": { "$ref": "scan-common.json#/$defs/uuid" },
        "state": { "type": "string", "enum": ["queued", "enrolling", "enrolled", "failed", "paused"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
