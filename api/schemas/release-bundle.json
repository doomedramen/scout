{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["manifest", "artifactBase64"],
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "version",
        "generation",
        "platform",
        "architecture",
        "digest",
        "bytes",
        "protocolMin",
        "protocolMax",
        "keyId",
        "signature"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "generation": { "type": "integer", "minimum": 1 },
        "platform": { "const": "linux" },
        "architecture": { "enum": ["amd64", "arm64"] },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "protocolMin": { "type": "integer", "minimum": 1 },
        "protocolMax": { "type": "integer", "minimum": 1 },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signature": { "type": "string", "minLength": 1, "writeOnly": true }
      },
      "additionalProperties": false
    },
    "artifactBase64": { "type": "string", "minLength": 1, "writeOnly": true }
  },
  "additionalProperties": false
}
