{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/retention-preview-input.json",
  "type": "object",
  "required": ["expectedRevision", "retention"],
  "properties": {
    "expectedRevision": { "$ref": "monitoring-common.json#/$defs/revision" },
    "retention": {
      "type": "object",
      "required": ["rawDays", "fiveMinuteDays", "hourlyDays"],
      "properties": {
        "rawDays": { "type": "integer", "minimum": 1, "maximum": 30 },
        "fiveMinuteDays": { "type": "integer", "minimum": 1, "maximum": 90 },
        "hourlyDays": { "type": "integer", "minimum": 1, "maximum": 365 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
