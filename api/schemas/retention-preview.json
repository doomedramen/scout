{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/retention-preview.json",
  "type": "object",
  "required": [
    "previewId",
    "expectedRevision",
    "retention",
    "affectedRanges",
    "estimatedRows",
    "irreversible",
    "expiresAt"
  ],
  "properties": {
    "previewId": { "$ref": "monitoring-common.json#/$defs/uuid" },
    "expectedRevision": { "$ref": "monitoring-common.json#/$defs/revision" },
    "retention": { "$ref": "monitoring-settings.json#/properties/retention" },
    "affectedRanges": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["tier", "before", "after"],
        "properties": {
          "tier": { "type": "string", "enum": ["raw", "fiveMinute", "hourly"] },
          "before": { "$ref": "monitoring-common.json#/$defs/timestamp" },
          "after": { "$ref": "monitoring-common.json#/$defs/timestamp" }
        },
        "additionalProperties": false
      }
    },
    "estimatedRows": { "type": "integer", "minimum": 0 },
    "irreversible": { "type": "boolean" },
    "expiresAt": { "$ref": "monitoring-common.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
