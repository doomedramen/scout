{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/entry-point-observation.json",
  "type": "object",
  "required": [
    "id",
    "runId",
    "pageOrdinal",
    "scopeId",
    "scopeRevision",
    "scanner",
    "address",
    "transport",
    "port",
    "entryPointId",
    "outcome",
    "reasonCode",
    "latencyMilliseconds",
    "observedAt",
    "receivedAt",
    "expiresAt",
    "actionable"
  ],
  "properties": {
    "id": { "$ref": "scan-common.json#/$defs/uuid" },
    "runId": { "$ref": "scan-common.json#/$defs/uuid" },
    "pageOrdinal": { "type": "integer", "minimum": 0, "maximum": 16383 },
    "scopeId": { "$ref": "scan-common.json#/$defs/uuid" },
    "scopeRevision": { "$ref": "scan-common.json#/$defs/revision" },
    "scanner": { "$ref": "scan-common.json#/$defs/scanner" },
    "address": { "type": "string", "minLength": 2, "maxLength": 45 },
    "transport": { "$ref": "scan-common.json#/$defs/transport" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "entryPointId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "outcome": { "$ref": "scan-common.json#/$defs/outcome" },
    "reasonCode": { "$ref": "scan-common.json#/$defs/reasonCode" },
    "latencyMilliseconds": { "type": ["number", "null"], "minimum": 0, "maximum": 10000 },
    "observedAt": { "$ref": "scan-common.json#/$defs/timestamp" },
    "receivedAt": { "$ref": "scan-common.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "scan-common.json#/$defs/timestamp" },
    "actionable": { "type": "boolean" }
  },
  "additionalProperties": false
}
