{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/setup.json",
  "type": "object",
  "required": ["setupToken", "password"],
  "properties": {
    "setupToken": { "type": "string", "minLength": 16, "maxLength": 256, "writeOnly": true },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "description": "At least 8 characters, including uppercase, lowercase, and a number.",
      "writeOnly": true
    }
  },
  "additionalProperties": false
}
