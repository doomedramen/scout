{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/scan-run.json",
  "type": "object",
  "required": [
    "id",
    "scopeId",
    "scopeRevision",
    "scanner",
    "trigger",
    "state",
    "scheduledAt",
    "assignmentExpiresAt",
    "targetsPlanned",
    "attemptsPlanned",
    "attemptsCompleted",
    "outcomeCounts",
    "partialReason",
    "errorCode",
    "pageCount"
  ],
  "properties": {
    "id": { "$ref": "scan-common.json#/$defs/uuid" },
    "scopeId": { "$ref": "scan-common.json#/$defs/uuid" },
    "scopeRevision": { "$ref": "scan-common.json#/$defs/revision" },
    "scanner": { "$ref": "scan-common.json#/$defs/scanner" },
    "trigger": { "type": "string", "enum": ["schedule", "owner"] },
    "state": { "$ref": "scan-common.json#/$defs/runState" },
    "scheduledAt": { "$ref": "scan-common.json#/$defs/timestamp" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "assignmentExpiresAt": { "$ref": "scan-common.json#/$defs/timestamp" },
    "targetsPlanned": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "attemptsPlanned": { "type": "integer", "minimum": 0, "maximum": 16384 },
    "attemptsCompleted": { "type": "integer", "minimum": 0, "maximum": 16384 },
    "outcomeCounts": {
      "type": "object",
      "required": ["open", "closed", "filtered", "unreachable", "skipped", "scannerError"],
      "properties": {
        "open": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "closed": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "filtered": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "unreachable": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "skipped": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "scannerError": { "type": "integer", "minimum": 0, "maximum": 16384 }
      },
      "additionalProperties": false
    },
    "partialReason": { "$ref": "scan-common.json#/$defs/partialReason" },
    "errorCode": { "type": ["string", "null"], "maxLength": 128 },
    "pageCount": { "type": "integer", "minimum": 0, "maximum": 16384 },
    "finalPageOrdinal": { "type": ["integer", "null"], "minimum": 0, "maximum": 16383 }
  },
  "additionalProperties": false
}
