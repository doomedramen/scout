{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.local/schemas/scan-policy-input.json",
  "type": "object",
  "required": ["serverEnabled", "agentIds", "scheduleSeconds", "entryPoints", "limits"],
  "properties": {
    "serverEnabled": { "type": "boolean" },
    "agentIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "scan-common.json#/$defs/uuid" }
    },
    "scheduleSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
    "entryPoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "scan-entry-point.json" }
    },
    "limits": { "$ref": "scan-common.json#/$defs/limits" }
  },
  "additionalProperties": false,
  "$comment": "The server validates enabled target and entry-point multiplication against attemptBudget before accepting this policy."
}
