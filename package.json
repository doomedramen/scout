{
  "name": "scout",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "db:up": "node scripts/compose.mjs up -d --wait postgres",
    "db:down": "node scripts/compose.mjs stop postgres"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  }
}
